// 화살표(->) 이용하는 switch문 
public class Ex04 {
	
	public static void main(String[] args) {
		String day = "FRI";
		String today = "";
		
		switch(day) {
		case "SAT", "SUN" -> today = "주말";
		case "MON", "TUE", "WED", "THU", "FRI" -> today = "주중";
		default -> System.out.println("오류");
		}
		
		System.out.println(today);
	}

}
