// -1이 입력될 때까지 입력한 정수의 합 구하기 

import java.util.Scanner;

public class Ex11 {

	public static void main(String[] args) {
		int sum = 0; 
		int num = 0;
		Scanner sc = new Scanner(System.in);
		
		while(num != -1) {
			sum += num;
			num = sc.nextInt();
		}
		System.out.println("sum = " + sum);
	}

}
